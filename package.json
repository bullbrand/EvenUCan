{
  "name": "evenucan",
  "productName": "EvenUCan",
  "version": "1.9.33",
  "description": "3D enclosure designer for novice makers — ESPHome/Arduino/Pi code generator",
  "author": "David John Waugh",
  "license": "SEE LICENSE IN app/LICENSE.txt",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.evenucan.app",
    "productName": "EvenUCan",
    "copyright": "Copyright © David John Waugh",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "app",
        "to": "webapp",
        "filter": [
          "**/*"
        ]
      }
    ],
    "icon": "build/icon",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EvenUCan",
      "artifactName": "EvenUCan-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "EvenUCan-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "EvenUCan-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "maintainer": "David John Waugh <noreply@evenucan.invalid>",
      "synopsis": "3D enclosure designer for novice makers",
      "artifactName": "EvenUCan-${version}.${ext}"
    },
    "deb": {
      "artifactName": "EvenUCan-${version}.${ext}"
    },
    "appImage": {
      "artifactName": "EvenUCan-${version}.${ext}"
    }
  },
  "homepage": "https://github.com/bullbrand/EvenUCan"
}
